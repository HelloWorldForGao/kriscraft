{
  "schemaVersion": 1,
  "id": "kriscraft",
  "version": "${version}",
  "name": "KrisCraft",
  "description": "Your HP was mossed out when you see this mod,the power of this mod is shining in your soul.",
  "authors": [],
  "contact": {},
  "license": "WTFPL",
  "icon": "assets/kriscraft/Kris.png",
  "environment": "*",
  "mixins": [
    {
      "config": "kriscraft.mixins.client.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "client": [
      "io.hwfg.kriscraft.client.KriscraftClient"
    ],
    "main": [
      "io.hwfg.kriscraft.Kriscraft"
    ],
    "fabric-datagen": [
      "io.hwfg.kriscraft.datagen.Datagen"
    ],
    "modmenu" : [
      "io.hwfg.kriscraft.config.ModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "modmenu" : ">=${modmenu_version}"
  },
  "custom" : {
    "modmenu" : {
      "badges" : [
        "moss",
        "deltarune"
      ],
      "links" : {
        "kriscraft.modmenu.general_idea" : "https://store.steampowered.com/app/1671210/DELTARUNE/",
        "kriscraft.modmenu.genshin" : "https://genshin.hoyoverse.com/",
        "kriscraft.modmenu.github" : "https://github.com/HelloWorldForGao/kriscraft",
        "kriscraft.modmenu.gitee" : "https://gitee.com/AetherAndLumine/kris-craft"
      }
    }
  }
}
